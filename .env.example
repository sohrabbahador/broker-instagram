# Required service settings
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/broker_database
TOKEN_ENC_KEY=GENERATE_FERNET_KEY
OAUTH_ADMIN_SECRET=GENERATE_LONG_RANDOM_SECRET
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
IG_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/ig/callback

# Instagram app credentials (only after Meta app is available)
IG_APP_ID=
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=GENERATE_RANDOM_VERIFY_TOKEN
IG_API_VERSION=v25.0

# Optional integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
BALE_TOKEN_SALE=
BALE_TOKEN_RENT=
ADMIN_ID=
PUBLISH_MODE=approval
